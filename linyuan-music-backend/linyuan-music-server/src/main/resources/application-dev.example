linyuan-music:
  datasource:
    url: jdbc:mysql://host:port/linyuan_music?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: username
    password: password
  redis:
    host: host
    port: port
    password:
  # 文件存储：local（默认，存本地磁盘）/ minio（对象存储）
  storage:
    type: local
    local-dir: ./uploads
    url-prefix: /files
    public-base-url: http://localhost:8080/files
  minio:
    endpoint: http://localhost:9000 # 修改你的 MinIO 端点
    accessKey: minioadmin # 修改你的 MinIO Access Key
    secretKey: minioadmin # 修改你的 MinIO Secret Key
    bucket: linyuan-music-data # 确认 Bucket 名称与你创建的一致
  mail:
    # 配置邮箱账户和密码（仅注册/找回密码发验证码用到，可留空）
    host: smtp.example.com # 填写你的 SMTP 服务器地址，例如 smtp.qq.com
    username: example@example.com # 填写你的邮箱账号
    password: example # 填写你的邮箱密码或者授权码，推荐使用授权码
